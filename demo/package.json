{
  "name": "demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p tsconfig.functions.json",
    "test:sql": "node supabase/pruebas/probar.mjs supabase/migrations",
    "test:ia": "node netlify/pruebas/factura.prueba.mts",
    "test": "npm run test:ia && npm run test:xubio && npm run test:espejo && npm run test:mails && npm run test:gas && npm run test:separacion && npm run test:organizaciones && npm run test:credenciales && npm run test:contabilizar && npm run test:sql",
    "test:mails": "node netlify/pruebas/mails.prueba.mts",
    "test:gas": "node netlify/pruebas/gas.prueba.mts",
    "test:contabilizar": "node --import ./netlify/pruebas/resolver.mjs netlify/pruebas/contabilizar.prueba.mts",
    "test:credenciales": "node --import ./netlify/pruebas/resolver.mjs netlify/pruebas/credenciales.prueba.mts",
    "test:organizaciones": "node --import ./netlify/pruebas/resolver.mjs netlify/pruebas/organizaciones.prueba.mts",
    "test:separacion": "node --import ./netlify/pruebas/resolver.mjs netlify/pruebas/separacion.prueba.mts",
    "test:xubio": "node netlify/pruebas/xubio.prueba.mts",
    "sql:unir": "node supabase/unir.mjs",
    "test:espejo": "node netlify/pruebas/espejo.prueba.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
